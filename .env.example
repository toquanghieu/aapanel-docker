# aaPanel container configuration. Copy to .env and adjust as needed.
#
# Every variable is OPTIONAL. If credentials are left unset, the panel
# auto-generates secure random values on first run and prints them to
# `docker logs aapanel`.

# Web UI port (published on the host and used inside the container).
AAPANEL_PORT=8888

# Login credentials. Leave commented to auto-generate strong random values.
# AAPANEL_USERNAME=admin
# AAPANEL_PASSWORD=

# Secured entry path - the random URL suffix you must hit to reach the panel
# (e.g. http://host:8888/my-secret-entry). Leave commented to auto-generate.
# AAPANEL_ENTRY=/my-secret-entry

# Serve the panel over HTTPS (on/off). Default: off.
# AAPANEL_SSL=off
